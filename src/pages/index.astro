---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import slugify from "@utils/slugify";
import { SOCIALS } from "@config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);

const socialCount = SOCIALS.filter(social => social.active).length;
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <h1 class="mr-2">Husband, Father, Worker</h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="rss-link"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="rss-icon"
          ><path
            d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"
          ></path><path
            d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"
          ></path><circle cx="6" cy="18" r="2"></circle>
        </svg>
      </a>

      <p>
        I am a husband to my beautiful wife, Patrisha.
      </p>
      <p>
        I am a father to my handsome son, Avery.
      </p>
      <p>
        As a worker, I am currently an OS level developer in a team that is maintaining a Linux distribution based on RHEL. I am experienced and very familiar with the RHEL/Fedora family of Linux.
      </p>
      <p>
        Before my full time career in software, I served in the U.S. Marine Corps Reserve for 8 years (2015-2023). 
        My MOS was 0621 Field Radio Operator and I was a small unit leader in multiple units as a Corporal and then Sergeant of Marines. 
        My service was not as eventful or fulfilling other than the usual peacetime Marine Corps experience but I met many good people and friends during my time and I learned many valuable lessons. 
        Any regrets? Too many to count. But I do not regret joining the greatest branch of the U.S. military.
      </p>
      <p>
        Between Marine Corps drills as a reservist, I was a full time student in George Mason University (2016-2020). 
        I majored in Information Technology with concentration in Web Development and Multimedia. 
      </p>
      <p>
        Between my classes as a college student, I worked part-time to earn some experience and money. 
        I briefly worked in retail and then I worked as a semi-conductor/PCB RMA material handler for 3.5 years before moving onto my first internship. 
      </p>
      <p>
        I interned as a DevOps Engineer in the Summer before my graduation in 2020. 
        My interests in learning Linux got me this internship and I learned all the Linux and command line fundamentals from my mentor. 
      </p>
      <p>
        Between the end of my internship and my graduation I was endlessly applying and interviewing in any job that's related to software and IT. 
        In the meantime I was working odd jobs in food delivery and security gigs to pay the bills. 
        After graduation it took me another 3 months until I landed my first role in my software career which I will always be grateful for. 
      </p>
      <p>
        I worked in my first software role as a Software Integration Engineer (2021-2023) and the job was heavily flavored in Linux which I loved.
        I was there for 2 years until I started my current role as a Linux Systems Engineer.
      </p>
      <p>
        Despite having a bachelors degree associated with Web Development, I have not professionally made any websites or webapps in my career yet. I'm aiming to relearn web development as a hobby.
      </p>

      {
        // only display if at least one social link is enabled
        socialCount > 0 && (
          <div class="social-wrapper">
            <div class="social-links">Some of my links:</div>
            <Socials />
          </div>
        )
      }
    </section>

  </main>

  <Footer />
</Layout>

<style>
  /* ===== Hero Section ===== */
  #hero {
    @apply pb-6 pt-8;
  }
  #hero h1 {
    @apply my-4 inline-block text-3xl font-bold sm:my-8 sm:text-5xl;
  }
  #hero .rss-link {
    @apply mb-6;
  }
  #hero .rss-icon {
    @apply mb-2 h-6 w-6 scale-110 fill-skin-accent sm:mb-3 sm:scale-125;
  }
  #hero p {
    @apply my-2;
  }
  .social-wrapper {
    @apply mt-4 flex flex-col sm:flex-row sm:items-center;
  }
  .social-links {
    @apply mb-1 mr-2 whitespace-nowrap sm:mb-0;
  }

  /* ===== Featured & Recent Posts Sections ===== */
  #featured,
  #recent-posts {
    @apply pb-6 pt-12;
  }
  #featured h2,
  #recent-posts h2 {
    @apply text-2xl font-semibold tracking-wide;
  }
  .all-posts-btn-wrapper {
    @apply my-8 text-center;
  }
</style>
